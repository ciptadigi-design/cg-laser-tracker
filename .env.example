# Supabase client configuration (future integration — not yet wired into the app).
# Copy to .env.local and fill in with real values from the ciptadigi-design
# Supabase project dashboard. Never commit .env or .env.local.
#
# The anon key is safe to ship to the browser ONLY because Row Level
# Security is enabled on every table (see supabase/migrations/). Never put
# a service_role key in a Vite env var — anything prefixed VITE_ is bundled
# into client-shipped JavaScript.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
